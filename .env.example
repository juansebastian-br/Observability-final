# Copy to .env and fill real values. Never commit .env.
# Hosts must be reachable from Docker (public endpoint with allowlist, VPN/private routing, or proxy).
GCP_DB_HOST=
GCP_DB_PORT=5432
GCP_DB_USER=
GCP_DB_PASSWORD=
GCP_DB_DATABASE=postgres
GCP_DB_SSL_MODE=require
AWS_DB_HOST=
AWS_DB_PORT=5432
AWS_DB_USER=
AWS_DB_PASSWORD=
AWS_DB_DATABASE=postgres
AWS_DB_SSL_MODE=require
# Set true only after both external DB connections work.
DATA_CHECK_ON_ORDER=true

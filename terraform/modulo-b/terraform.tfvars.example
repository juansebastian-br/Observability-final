# Copiar a terraform.tfvars (ignorado por git) y ajustar.
project_id = "crafty-dynamics-239114"
region     = "us-central1"

latency_slo_seconds = 1.5

# Canales de notificación como propiedad: agrega, quita o cambia sin tocar los módulos.
notification_channels = {
  oncall_email = {
    type   = "email"
    labels = { email_address = "tu-correo@example.com" }
  }
